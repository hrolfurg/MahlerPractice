# Copy this file to .env and fill in the values before running in production.

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Site login credentials
APP_USERNAME=mahler
APP_PASSWORD=mahler

# Cloudflare Tunnel token — obtain from Zero Trust dashboard → Networks → Tunnels
# Create a tunnel, then copy the token shown in the connector install instructions.
TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
